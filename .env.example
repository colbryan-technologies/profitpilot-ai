# Shopify (from Partner Dashboard; `shopify app config link` fills shopify.app.toml)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.example.com
SCOPES=read_orders,read_all_orders,read_products,read_inventory,read_shipping,read_locales

# Shopify App Pricing (Partner API, used only to read the merchant's active plan)
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_ACCESS_TOKEN=
SHOPIFY_APP_GID=gid://shopify/App/0
SHOPIFY_APP_HANDLE=profitpilot-ai
BILLING_TEST_MODE=true

# Infrastructure
DATABASE_URL=postgresql://user:password@localhost:5432/profitpilot
REDIS_URL=redis://localhost:6379
# 32 bytes, hex encoded: `openssl rand -hex 32`
ENCRYPTION_KEY=
WORKER_CONCURRENCY=4

# AI (optional; "none" disables the copilot and uses deterministic summaries)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL_FAST=gpt-4o-mini
AI_MODEL_STRONG=gpt-4o
AI_TIMEOUT_MS=30000

# Advertising integrations (optional)
META_APP_ID=
META_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Operations
SENTRY_DSN=
LOG_LEVEL=info
PLATFORM_ADMIN_SHOPS=
PLATFORM_ADMIN_TOKEN=
RATE_LIMIT_PER_MINUTE=240
